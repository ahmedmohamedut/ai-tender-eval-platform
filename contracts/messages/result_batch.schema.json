{
  "$defs": {
    "ParsedFiles": {
      "description": "The hand-over of one parsed document version (PI 5.6, kind ``parsed``).\n\nKeys are in ``tender-derived`` and are the fixed keys of AI 3.3.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "manifest": {
          "title": "Manifest",
          "type": "string"
        },
        "page_count": {
          "minimum": 0,
          "title": "Page Count",
          "type": "integer"
        },
        "pages": {
          "title": "Pages",
          "type": "string"
        },
        "passages": {
          "title": "Passages",
          "type": "string"
        },
        "rendered_pdf": {
          "title": "Rendered Pdf",
          "type": "string"
        },
        "sections": {
          "title": "Sections",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "pages",
        "sections",
        "passages",
        "rendered_pdf",
        "manifest",
        "page_count",
        "counts",
        "source_sha256"
      ],
      "title": "ParsedFiles",
      "type": "object"
    },
    "Target": {
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "document_version",
            "proposal_version",
            "tender"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Target",
      "type": "object"
    },
    "WorkerInfo": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "WorkerInfo",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Body of documents.analysis.result.{job_type} (PI 5.6): at most 50 items.",
  "properties": {
    "emitted_at": {
      "format": "date-time",
      "title": "Emitted At",
      "type": "string"
    },
    "final": {
      "title": "Final",
      "type": "boolean"
    },
    "items": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "job_type": {
      "enum": [
        "document_processing",
        "requirement_extraction",
        "screening_precheck",
        "evaluation"
      ],
      "title": "Job Type",
      "type": "string"
    },
    "kind": {
      "enum": [
        "parsed",
        "requirements",
        "grades",
        "prechecks"
      ],
      "title": "Kind",
      "type": "string"
    },
    "parsed": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParsedFiles"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "part_no": {
      "minimum": 1,
      "title": "Part No",
      "type": "integer"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "tender_id": {
      "format": "uuid",
      "title": "Tender Id",
      "type": "string"
    },
    "worker": {
      "$ref": "#/$defs/WorkerInfo"
    }
  },
  "required": [
    "job_id",
    "job_type",
    "tender_id",
    "target",
    "kind",
    "part_no",
    "final",
    "emitted_at",
    "worker"
  ],
  "title": "ResultBatch",
  "type": "object",
  "x-tender-schema": "tender.analysis.result/1"
}
