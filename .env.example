# Local development only. Copy to .env (git-ignored). Every value below is a
# throwaway development value; nothing here is a real secret. Real environments
# take secrets from OpenBao (docs/design/04-platform-integration-design.md 7.1).

# Host ports. Non-standard on purpose so a local Postgres or NATS does not clash.
GATEWAY_PORT=18080
KEYCLOAK_PORT=18081
POSTGRES_PORT=15432
NATS_PORT=14222
NATS_MONITOR_PORT=18222
RUSTFS_PORT=19000
RUSTFS_CONSOLE_PORT=19001
QDRANT_PORT=16333
PHOENIX_PORT=16006
OPENBAO_PORT=18200
MAILPIT_SMTP_PORT=11025
MAILPIT_HTTP_PORT=18025

# Public URLs the browser uses
PUBLIC_BASE_URL=http://localhost:18080
SPA_BASE_URL=http://localhost:18080
KEYCLOAK_PUBLIC_URL=http://localhost:18081

# PostgreSQL: server superuser used only by provisioning
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-postgres-superuser
POSTGRES_DB=tender_eval
TENDER_OWNER_PASSWORD=dev-tender-owner
TENDER_APP_PASSWORD=dev-tender-app
TENDER_AI_INGEST_PASSWORD=dev-tender-ai-ingest
KEYCLOAK_DB_PASSWORD=dev-keycloak-db

# Keycloak (PI 7.5)
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-kc-master-admin
KEYCLOAK_BACKEND_ADMIN_SECRET=dev-backend-admin-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_TEMP_PASSWORD=dev-Temp-Password-1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=tender-eval@example.test
SMTP_USER=dev
SMTP_PASSWORD=dev-smtp

# RustFS (root identity is used only by provisioning)
RUSTFS_ACCESS_KEY=devrustfsroot
RUSTFS_SECRET_KEY=dev-rustfs-root-secret

# OpenBao dev mode
OPENBAO_DEV_ROOT_TOKEN=dev-openbao-root-token

# OpenBao AppRoles, one per component (throwaway development values)
OPENBAO_BACKEND_ROLE_ID=dev-role-backend
OPENBAO_BACKEND_SECRET_ID=dev-secret-id-backend-0000000000
OPENBAO_WORKER_INGEST_ROLE_ID=dev-role-worker-ingest
OPENBAO_WORKER_INGEST_SECRET_ID=dev-secret-id-worker-ingest-00000
OPENBAO_WORKER_AGENT_ROLE_ID=dev-role-worker-agent
OPENBAO_WORKER_AGENT_SECRET_ID=dev-secret-id-worker-agent-000000

# Qdrant
QDRANT_API_KEY=dev-qdrant-rw
QDRANT_READ_ONLY_API_KEY=dev-qdrant-ro

# Phoenix
PHOENIX_SECRET=dev-phoenix-secret-dev-phoenix-secret-1

# Component configuration (names from PI 7.3 and 7.4)
KEYCLOAK_AUDIENCE=tender-api
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_BUCKET_DOCUMENTS=tender-documents
S3_BUCKET_DERIVED=tender-derived
S3_BUCKET_JOBS=tender-jobs
S3_BUCKET_EXPORTS=tender-exports
QDRANT_COLLECTION=passages
NATS_PROVISION_STREAMS=false
LOG_LEVEL=info

# Development seed users (make seed-dev-users, run by make up): member01, member02, observer01.
# One throwaway password for all three. Never used outside local development.
DEV_SEED_USER_PASSWORD=dev-Password-1234

# Embeddings: the development stub (a hash, not a model). Replace with the approved endpoint.
EMBEDDING_MODEL=stub-hash-256
EMBEDDING_DIMENSIONS=256
EMBEDDING_API_KEY=dev-embedding-key

# Language model for extraction. Default: the rule-based stub (a stand-in, not a model).
# To use a local OpenAI-compatible server for SYNTHETIC documents, for example vLLM on the host:
#   LLM_BASE_URL=http://host.docker.internal:8888/v1
#   LLM_MODEL_EXTRACTION=gemma-4-26B-A4B
# Never point this at an endpoint you have not approved for the documents you upload (rule 15).
LLM_BASE_URL=
LLM_API_KEY=dev-llm-key
LLM_MODEL_EXTRACTION=
LLM_MODEL_VERSION=
